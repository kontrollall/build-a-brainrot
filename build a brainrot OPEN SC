-- Load Wizard UI Library
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/bloodball/-back-ups-for-libs/main/wizard"))()
local Window = Library:NewWindow("Script")
local MainSection = Window:NewSection("Credits: TGMANKASKE")

-- Variable to store the amount entered by the user
local enteredAmount = 0

-- TextBox: User inputs amount of money to give
MainSection:CreateTextBox("Enter money amount", "Example: 5000", true, function(text)
    local number = tonumber(text)
    if number and number > 0 then
        enteredAmount = number
        print("Amount set to:", enteredAmount)
    else
        warn("Invalid number entered.")
        enteredAmount = 0
    end
end)

-- Button: Fires the RemoteEvent with the entered amount
MainSection:CreateButton("Give Money", function()
    if enteredAmount > 0 then
        local rewardType = "Cash"
        local remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):FindFirstChild("giveRewards")

        if remote and remote:IsA("RemoteEvent") then
            remote:FireServer(rewardType, enteredAmount)
            print("Money sent:", enteredAmount)
        else
            warn("RemoteEvent 'giveRewards' not found or is not a RemoteEvent.")
        end
    else
        warn("Amount must be greater than zero.")
    end
end)
